                  "value": "EFO"
                }
              ],
              "value": "array scanning protocol"
            },
            {
              "name": "Description",
              "value": "The BeadChips were scanned on an Illumina BeadArray Reader."
            }
          ],
          "type": "Protocols"
        }
      ],
