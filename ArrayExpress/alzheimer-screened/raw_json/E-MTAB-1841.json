{
  "accno": "E-MTAB-1841",
  "attributes": [
    {
      "name": "Title",
      "value": "Transcription profiling of SH-SY5Y cells after treatment with soluble Abeta42_wt, Abeta42_G33A and Abeta40 for different timepoints"
    },
    {
      "name": "ReleaseDate",
      "value": "2014-12-01"
    },
    {
      "name": "RootPath",
      "value": "E-MTAB-1841"
    },
