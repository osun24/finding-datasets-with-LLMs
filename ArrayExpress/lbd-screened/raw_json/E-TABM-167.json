  "section": {
    "accno": "s-E-TABM-167",
    "attributes": [
      {
        "name": "Title",
        "value": "Transcription profiling of high and low grade gliomas from human patients to identify new diagnostic and prognostic markers"
      },
      {
        "name": "Study type",
        "valqual": [
          {
            "name": "Ontology",
            "value": "EFO"
          },
          {
            "name": "TermId",
            "value": "EFO_0002768"
          }
        ],
        "value": "transcription profiling by array"
      },
      {
        "name": "Organism",
        "value": "Homo sapiens"
      },
      {
        "name": "Description",
        "value": "Comparison of high grade  to low grade gliomas."
      }
    ],
    "subsections": [
      [
        {
          "accno": "P-TABM-859",
          "attributes": [
            {
              "name": "Name",
              "value": "P-TABM-859"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "mo"
                }
              ],
              "value": "specified_biomaterial_action"
            },
            {
              "name": "Description",
              "value": "A commercial total brain RNA mix was used (Ambion, Inc. USA). The commercial RNA was isolated from a donor who had no history of cancer, or brain disorders. All tumors were hybridized against this normal total brain reference."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-TABM-858",
          "attributes": [
            {
              "name": "Name",
              "value": "P-TABM-858"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "mo"
                }
              ],
              "value": "specified_biomaterial_action"
            },
            {
              "name": "Description",
              "value": "Glioma samples were collected from patients who underwent surgery at Royal North Shore Hospital, North Shore Private Hospital, and Prince of Wales Private Hospital, NSW, Australia. Approval for this study was obtained from the Human Research Ethics Committees of the participating institutions. No patients received chemotherapy or radiotherapy prior to surgery. Surgically removed gliomas for RNA extraction were snap-frozen in liquid nitrogen immediately and stored at -80ºC until use. Pathology reports for all patients included in this study were reviewed for the presence of necrosis and microvascular proliferation (MVP). Necrosis was defined as either: geographic, palisaded or infarct (2) and MVP was defined as mild, moderate or glomeruloid (marked) proliferation (21). Gliomas presenting with necrosis and/or MVP were reclassified as high grade gliomas for the duration of this study. Gliomas with no description of necrosis and/or MVP were grouped and renamed low grade."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-TABM-854",
          "attributes": [
            {
              "name": "Name",
              "value": "P-TABM-854"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology"
                }
              ],
              "value": "nucleic_acid_extraction"
            },
            {
              "name": "Description",
              "value": "Total RNA was extracted from fresh frozen brain tumor tissue using QIAZOL reagent (Qiagen GmbH, Strasse, Germany) and purified by precipitation with 2.5 mol/L LiCl2 according to the manufacturers protocols (Ambion, Inc., Austin, TX, USA). Purified RNA was quantitated by UV absorbance at 260 and 280nm and assessed qualitatively by formaldehyde agarose gel electrophoresis."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-TABM-856",
          "attributes": [
            {
              "name": "Name",
              "value": "P-TABM-856"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "mo"
                }
              ],
              "value": "labeling"
            },
            {
              "name": "Description",
              "value": "For each glioma, 20µg of purified RNA from both the tumor and the normal total brain control were reversed transcribed using Superscript III (Invitrogen® San Diego, CA, USA) and anchored oligo-(dT20VN) in the presence of Cy5-dCTP and Cy3-dCTP (Amersham Inc., Piscataway NJ, USA) as described previously (22)."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-TABM-855",
          "attributes": [
            {
              "name": "Name",
              "value": "P-TABM-855"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology"
                }
              ],
              "value": "hybridization"
            },
            {
              "name": "Description",
              "value": "Microarray slides printed with the Compugen 19,000 human oligonucleotide library were obtained from the Adelaide Microarray Facility, University of Adelaide, Australia. The oligonucleotides were immobilized to the surface of each slide by baking and UV-linking. An array list, H19K array list v3.01.gal, was provided with the chips. Slides from one print batch only were used in these experiments. After direct labeling, the two probes were hybridized for 20 hours at 50ºC to a microarray slide."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-TABM-857",
          "attributes": [
            {
              "name": "Name",
              "value": "P-TABM-857"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "The MGED Ontology"
                }
              ],
              "value": "feature_extraction"
            },
            {
              "name": "Description",
              "value": "The slides were washed, immediately dried, and scanned with a 10-µm resolution on a GenePix 4000A scanner (Molecular Devices, Sunnyvale, CA, USA) at wavelengths 635 and 532 nm for Cy5- and Cy3- labeled probes, respectively. The resulting TIFF images were analyzed by GenePix Pro 4.0 software (Molecular Devices, Sunnyvale, CA, USA)."
            }
          ],
          "type": "Protocols"
        }
      ],
