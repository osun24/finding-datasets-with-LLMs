      [
        {
          "accno": "P-MTAB-27264",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-27264"
            },
            {
              "name": "Type",
              "value": "nucleic_acid_extraction"
            },
            {
              "name": "Description",
              "value": "RNA from the frontal cortex (area 8) of Parkinson cases and controls were extracted and further purified with RNeasy Lipid Tissue Mini Kit (Qiagen, DE) following the protocol provided by the manufacturer. The concentration of each sample was obtained from A260 measurements with Nanodrop 1000. RNA integrity was tested using the Agilent 2100 BioAnalyzer (Agilent, US)."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-MTAB-27265",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-27265"
            },
            {
              "name": "Type",
              "value": "labeling"
            },
            {
              "name": "Description",
              "value": "Briefly, sense ssDNA suitable for labelling was generated from total RNA with the Ambion WT Expression Kit from Ambion (Carlsbad, CA, US) according to the manufacturerM-^Rs instructions. Sense ssDNA was fragmented, labelled and hybridized to the arrays with the GeneChip WT Terminal Labeling and Hybridization Kit from Affymetrix (Affymetrix, Santa Clara, CA, US)."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-MTAB-27266",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-27266"
            },
            {
              "name": "Type",
              "value": "hybridization"
            },
            {
              "name": "Description",
              "value": "Briefly, sense ssDNA suitable for labelling was generated from total RNA with the Ambion WT Expression Kit from Ambion (Carlsbad, CA, US) according to the manufacturerM-^Rs instructions. Sense ssDNA was fragmented, labelled and hybridized to the arrays with the GeneChip WT Terminal Labeling and Hybridization Kit from Affymetrix (Affymetrix, Santa Clara, CA, US)."
            }
