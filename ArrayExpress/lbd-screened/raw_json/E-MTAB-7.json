    "subsections": [
      [
        {
          "accno": "P-MTAB-61",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-61"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology"
                }
              ],
              "value": "nucleic_acid_extraction"
            },
            {
              "name": "Description",
              "value": "Total RNA was extracted from cell lines using Trizol, according to standard protocols (Invitrogen). RNA integrity was assessed by denaturing formaldehyde agarose gel electrophoresis or by micro-analysis (Agilent Bioanalyzer, Palo Alto, CA, USA)."
            },
            {
              "name": "Software"
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-MTAB-62",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-62"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology"
                }
              ],
              "value": "labeling"
            },
            {
              "name": "Description",
              "value": "Total RNA was prepared from samples using Trizol reagent (GIBCO BRL Life Technologies) and quality was assessed on the Agilent Bioanalyser 2100. Preparation of in vitro transcription (IVT) products, oligonucleotide array hybridization and scanning were performed according to Affymetrix¨ (Santa Clara, California) protocols. In brief, 5 _g of total RNA from each breast cancer cell line and T7-linked oligo-dT primers were used for first-strand cDNA synthesis. IVT reactions were performed to generate biotinylated cRNA targets, which were chemically fragmented at 95¡C for 35 minutes. Fragmented biotinylated cRNA (10 _g) was hybriized at 45¡C for 16 hours to Affymetrix¨ high density oligonucleotide array human HG-U133A chip. The arrays were washed and stained with streptavidin-phycoerythrin (SAPE, final concentration 10 _g/ml). Signal amplification was performed using a biotinylated anti-streptavidin antibody. The array was scanned according to the manufacturer's instructions (Affymetrix Genechip¨ Technical Manual, 2001). Scanned images were inspected for the presence of obvious defects (artifacts or scratches) on the array. Defective chips were excluded and the sample was re-analyzed."
            },
            {
              "name": "Software"
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-MTAB-60",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-60"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology"
                }
              ],
              "value": "grow"
            },
            {
              "name": "Description",
              "value": "Cell lines were grown to sub-confluent densities in RPMI, 10% FBS, 37¡c, 5% CO2 media"
            },
            {
              "name": "Software"
            }
          ],
          "type": "Protocols"
        },
