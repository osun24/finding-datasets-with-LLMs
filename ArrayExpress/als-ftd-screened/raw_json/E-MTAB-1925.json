        ],
        "value": "transcription profiling by array"
      },
      {
        "name": "Organism",
        "value": "Homo sapiens"
      },
      {
        "name": "Description",
        "value": "The purpose of this experiment was to compare differences in the transcript level between RNA samples collected from post-mortem motor cortex from healthy control patients and amyotrophic lateral sclerosis (ALS) patients that carry an expanded GGGGCC repeat mutation in the chromosome 9 open reading frame 72 (C9ORF72) gene."
      }
    ],
    "links": [
      [
        {
          "attributes": [
            {
              "name": "Type",
              "value": "gxa"
            }
          ],
          "url": "E-MTAB-1925"
        }
      ]
    ],
    "subsections": [
      [
        {
          "accno": "P-MTAB-35081",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-35081"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "EFO"
                }
              ],
              "value": "growth protocol"
            },
            {
              "name": "Description",
              "value": "Human motor cortex tissue was dissected from autopsied patient tissue of healthy control patients and amyotrophic lateral sclerosis (ALS) patients that carry a hexanucleotide repeat expansion mutation in the chromosome 9 open reading frame 72 (C9ORF72). RNA was isolated from ~50 g tissue samples located within layers 3 - 5 of the postmortem motor cortex.    All procedures and tissue use  were performed at Johns Hopkins University Hospital according to approved protocols."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-MTAB-35082",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-35082"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "EFO"
                }
              ],
              "value": "nucleic acid extraction protocol"
            },
            {
              "name": "Description",
              "value": "Trizol extraction with column purification, using Qiagen Rneasy column and on-column Dnase treatment (Qiagen)."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-MTAB-35083",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-35083"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "EFO"
                }
              ],
              "value": "normalization data transformation protocol"
            },
            {
              "name": "Description",
              "value": "Affymetrix CEL files were extracted and their data normalized with the Partek GS 6.6 platform.  Partek's Extended Meta-Probeset set was used with RMA normalization to create quantile-normalized log2 transcript signal values, which were used in subsequent ANOVA analyses."
            }
          ],
          "type": "Protocols"
        }
      ],
