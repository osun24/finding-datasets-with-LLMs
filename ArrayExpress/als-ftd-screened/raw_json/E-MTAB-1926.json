  "section": {
    "accno": "s-E-MTAB-1926",
    "attributes": [
      {
        "name": "Title",
        "value": "Transcriptome profile of C9ORF72 ALS fibroblast"
      },
      {
        "name": "Study type",
        "valqual": [
          {
            "name": "Ontology",
            "value": "EFO"
          },
          {
            "name": "TermId",
            "value": "EFO_0002768"
          }
        ],
        "value": "transcription profiling by array"
      },
      {
        "name": "Organism",
        "value": "Homo sapiens"
      },
      {
        "name": "Description",
        "value": "The purpose of this experiment was to compare the differences in transcript levels between RNA samples collected from fibroblasts from healthy control patients, amyotrophic lateral sclerosis (ALS) patients carrying an expanded GGGGCC repeat mutation in the chromosome 9 open reading frame 72 gene and ALS patients with a mutation in the SOD1 gene."
      }
    ],
    "subsections": [
      [
        {
          "accno": "P-MTAB-35084",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-35084"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "EFO"
                }
              ],
              "value": "growth protocol"
            },
            {
              "name": "Description",
              "value": "Primary fibroblast cultures biopsied from amyotrophic lateral sclerosis patients were  grown to generate a primary fibroblast cell line. The fibroblasts were grown to confluency on collagen coated plates without antibiotics and then RNA was isolated by scraping.  Fibroblasts were used in this experiment since no model exists to study C9ORF72 ALS and to determine if, when compared to tissue of the central nervous system, this is a viable model to study the C9ORF72 ALS."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-MTAB-35085",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-35085"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "EFO"
                }
              ],
              "value": "nucleic acid extraction protocol"
            },
            {
              "name": "Description",
              "value": "Trizol extraction with column purification, using Qiagen Rneasy column and on-column Dnase treatment (Qiagen)."
            }
          ],
          "type": "Protocols"
        },
        {
          "accno": "P-MTAB-35086",
          "attributes": [
            {
              "name": "Name",
              "value": "P-MTAB-35086"
            },
            {
              "name": "Type",
              "valqual": [
                {
                  "name": "Ontology",
                  "value": "EFO"
                }
              ],
              "value": "normalization data transformation protocol"
            },
            {
              "name": "Description",
              "value": "Affymetrix CEL files were extracted and their data normalized with the Partek GS 6.6 platform.  Partek's Extended Meta-Probeset set was used with RMA normalization to create quantile-normalized log2 transcript signal values, which were used in subsequent ANOVA analyses."
            }
          ],
          "type": "Protocols"
        }
      ],
