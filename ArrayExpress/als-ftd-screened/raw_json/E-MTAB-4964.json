    "accno": "s-E-MTAB-4964",
    "attributes": [
      {
        "name": "Title",
        "value": "Microenvironment-driven resistance to B-Raf inhibition in a melanoma patient is accompanied by broad changes of gene methylation and expression in distal fibroblasts. Transcriptomic study."
      },
      {
        "name": "Study type",
        "valqual": [
          {
